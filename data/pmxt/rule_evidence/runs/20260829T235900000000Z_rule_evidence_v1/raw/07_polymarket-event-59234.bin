ublishedAt":"2024-02-06 19:42:10.126+00","createdAt":"2024-02-06T19:42:10.132Z","updatedAt":"2026-04-17T20:37:36.506311Z","requiresTranslation":false},{"id":"104094","label":"Governor midterms","slug":"governor-midterms","forceShow":false,"createdAt":"2026-03-04T19:55:35.574097Z","updatedAt":"2026-04-17T20:31:10.357429Z","isCarousel":false,"requiresTranslation":false},{"id":"104011","label":"Alaska Midterm","slug":"alaska-midterm","createdAt":"2026-03-02T20:00:46.049911Z","updatedAt":"2026-03-09T22:28:03.416431Z","requiresTranslation":false},{"id":"103160","label":"Rewards 50, 4.5, 20","slug":"rewards-50-4pt5-20","forceShow":false,"createdAt":"2026-01-15T20:27:46.240214Z","updatedAt":"2026-04-17T17:18:59.132757Z","isCarousel":false,"requiresTranslation":false}],"cyom":false,"showAllOutcomes":true,"showMarketImages":true,"enableNegRisk":true,"automaticallyActive":true,"gmpChartMode":"default","negRiskAugmented":true,"estimateValue":false,"cumulativeMarkets":false,"pendingDeployment":false,"deploying":false,"deployingTimestamp":"2025-10-13T21:16:42.389585Z","requiresTranslation":false,"eventMetadata":{"context_description":"Jonathan Kreiss-Tomkins leads the Alaska governor market at 48.1% following his first-place finish in the August 18 open primary and Democratic consolidation after Tom Begich withdrew on August 28 and endorsed him. The nonpartisan primary advanced Kreiss-Tomkins (22.5%), Begich (20.8%), Bernadette Wilson (10.4%), and Dave Bronson (8.4%) to the November 3 general election, which uses ranked-choice voting. Wilson and Bronson trail at 35.5% and 10.4% amid a fragmented Republican field that includes Treg Taylor and others. Recent candidate forums highlighted divides on oil and gas taxes and state revenue, while the open seat after Mike Dunleavy’s term limit and potential Republican vote splitting have shaped trader positioning ahead of the general election.","context_requires_regen":false,"context_updated_at":"2026-08-30T00:01:43.957Z"},"version":"v1"}
